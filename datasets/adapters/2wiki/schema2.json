{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.research/schema/data-truth-v2.0.json",
  "title": "Unified Dataset Truth Schema 2.0",
  "description": "Dataset truth layer for normalized claim-source research data, including the complete per-sample document catalog. Agent message-trace fields are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_manifest",
    "semantic_screening",
    "sample",
    "documents",
    "claims",
    "sources",
    "claim_source_links",
    "reasoning_graph",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "dataset_manifest": {
      "$ref": "#/$defs/datasetManifest"
    },
    "semantic_screening": {
      "$ref": "#/$defs/semanticScreening"
    },
    "sample": {
      "$ref": "#/$defs/sample"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claim_source_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimSourceLink"
      }
    },
    "reasoning_graph": {
      "$ref": "#/$defs/reasoningGraph"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rawLocator": {
      "type": "object",
      "description": "Dataset-native locator fields retained without destructive normalization.",
      "additionalProperties": true
    },
    "datasetManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "release",
        "split",
        "source_file",
        "file_sha256",
        "adapter_version",
        "schema_version"
      ],
      "properties": {
        "dataset_name": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "adapter_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "const": "2.0"
        }
      }
    },
    "semanticScreening": {
      "type": "object",
      "description": "Top-level provenance for GPT semantic screening. GPT judgments remain in a separate result artifact.",
      "additionalProperties": false,
      "required": [
        "method",
        "model",
        "reasoning_effort",
        "prompt_version",
        "rule_version",
        "screened_at",
        "requires_human_audit"
      ],
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "gpt",
            null
          ]
        },
        "model": {
          "$ref": "#/$defs/nullableString"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            null
          ]
        },
        "prompt_version": {
          "$ref": "#/$defs/nullableString"
        },
        "rule_version": {
          "type": "string"
        },
        "screened_at": {
          "$ref": "#/$defs/nullableString"
        },
        "requires_human_audit": {
          "type": "boolean"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "original_sample_id",
        "dataset_name",
        "release",
        "split",
        "question",
        "answer",
        "question_type",
        "answerability",
        "raw_locator",
        "normalization_status",
        "exclusion_reason"
      ],
      "properties": {
        "sample_id": {
          "type": "string"
        },
        "original_sample_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "dataset_name": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "answer": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "question_type": {
          "$ref": "#/$defs/nullableString"
        },
        "answerability": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "raw_locator": {
          "$ref": "#/$defs/rawLocator"
        },
        "normalization_status": {
          "enum": [
            "normalized",
            "excluded"
          ]
        },
        "exclusion_reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "sample_id",
        "claim_text",
        "structured_form",
        "claim_kind",
        "parent_claim_ids",
        "derivation_operator",
        "derivation_rule_version",
        "annotation_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "structured_form": {
          "$ref": "#/$defs/structuredForm"
        },
        "claim_kind": {
          "enum": [
            "direct",
            "derived"
          ],
          "description": "Whether the claim is generated from one source unit (direct) or multiple source units (derived); independent of GPT support judgment."
        },
        "parent_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "derivation_operator": {
          "type": "string"
        },
        "derivation_rule_version": {
          "type": "string"
        },
        "annotation_status": {
          "enum": [
            "candidate",
            "silver",
            "gold_audit",
            "rejected"
          ]
        }
      }
    },
    "structuredForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "object",
        "subject_qid",
        "object_qid"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "subject_qid": {
          "$ref": "#/$defs/nullableString"
        },
        "object_qid": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "documentSentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_index",
        "text"
      ],
      "properties": {
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_index",
        "title",
        "text",
        "sentences",
        "is_supporting_context",
        "raw_locator"
      ],
      "properties": {
        "context_index": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "text": {
          "type": "string"
        },
        "sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentSentence"
          }
        },
        "is_supporting_context": {
          "type": "boolean"
        },
        "raw_locator": {
          "$ref": "#/$defs/rawLocator"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sample_id",
        "context_index",
        "title",
        "entity_qid",
        "paragraph_idx",
        "sent_id",
        "char_start",
        "char_end",
        "text",
        "granularity",
        "source_origin",
        "raw_locator",
        "locator_status"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "context_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Per-sample foreign key to documents[].context_index. It replaces the former document_id field."
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "entity_qid": {
          "$ref": "#/$defs/nullableString",
          "description": "For 2Wiki, fill only when source.title exactly equals a linked claim subject or object with an explicit QID; otherwise null."
        },
        "paragraph_idx": {
          "$ref": "#/$defs/nullableInteger"
        },
        "sent_id": {
          "$ref": "#/$defs/nullableInteger"
        },
        "char_start": {
          "$ref": "#/$defs/nullableInteger"
        },
        "char_end": {
          "$ref": "#/$defs/nullableInteger"
        },
        "text": {
          "type": "string"
        },
        "granularity": {
          "enum": [
            "sentence",
            "paragraph",
            "sentence_set"
          ]
        },
        "source_origin": {
          "enum": [
            "official_gold",
            "derived"
          ]
        },
        "raw_locator": {
          "$ref": "#/$defs/rawLocator"
        },
        "locator_status": {
          "enum": [
            "unverified",
            "valid",
            "invalid"
          ]
        }
      }
    },
    "claimSourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "claim_id",
        "source_ids",
        "relation",
        "validation_status",
        "automatic_match_reason",
        "confidence",
        "needs_review",
        "reviewer",
        "review_timestamp",
        "rule_version"
      ],
      "properties": {
        "link_id": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "relation": {
          "enum": [
            "direct_entailment",
            "joint_entailment",
            "derivation_premise"
          ]
        },
        "validation_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "automatic_match_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Structural matching confidence only; not GPT semantic confidence."
        },
        "needs_review": {
          "type": "boolean"
        },
        "reviewer": {
          "$ref": "#/$defs/nullableString"
        },
        "review_timestamp": {
          "$ref": "#/$defs/nullableString"
        },
        "rule_version": {
          "type": "string"
        }
      }
    },
    "reasoningEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_node_ids",
        "target_node_id",
        "relation"
      ],
      "properties": {
        "source_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "target_node_id": {
          "$ref": "#/$defs/nullableString"
        },
        "relation": {
          "enum": [
            "inference",
            "comparison"
          ]
        }
      }
    },
    "reasoningGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_graph_id",
        "sample_id",
        "node_ids",
        "edges",
        "reasoning_hop_count",
        "graph_type",
        "graph_origin"
      ],
      "properties": {
        "reasoning_graph_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reasoningEdge"
          }
        },
        "reasoning_hop_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of claim nodes on the longest dependency path; comparison edges do not add a hop."
        },
        "graph_type": {
          "type": "string"
        },
        "graph_origin": {
          "enum": [
            "official_gold",
            "derived"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors",
        "warnings",
        "validator_version",
        "validated_at"
      ],
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "qualified",
            "excluded",
            null
          ]
        },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "validator_version": {
          "type": "string"
        },
        "validated_at": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
