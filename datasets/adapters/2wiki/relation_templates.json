{
  "version": "1.0.0",
  "description": "Machine-readable transcription of relation_process_rules.md. Templates are adapter-stage surface forms; GPT performs the listed language/semantic checks.",
  "possessive_rule": "possessive(subject) returns the complete possessive string: append apostrophe only when the subject ends in s/S; otherwise append apostrophe+s.",
  "relations": {
    "publication date": {"template": "{subject} was published in {object}.", "gpt_checks": []},
    "father": {"template": "{subject_possessive} father is {object}.", "gpt_checks": []},
    "country": {"template": "{subject} is in {object}.", "gpt_checks": ["article_naturalness"]},
    "award received": {"template": "{subject} received the {object}.", "gpt_checks": ["article_repair", "whether_award_word_is_needed"]},
    "cause of death": {"template": "{subject_possessive} cause of death was {object}.", "gpt_checks": ["article_naturalness"]},
    "child": {"template": "{object} is a child of {subject}.", "gpt_checks": []},
    "composer": {"template": "{subject_possessive} composer is {object}.", "gpt_checks": ["possessive_naturalness"]},
    "country of citizenship": {"template": "{subject} is a citizen of {object}.", "gpt_checks": ["demonym_or_country_naturalness"]},
    "country of origin": {"template": "{subject} originates from {object}.", "gpt_checks": []},
    "creator": {"template": "{subject_possessive} creator is {object}.", "gpt_checks": ["possessive_naturalness"]},
    "date of birth": {"template": "{subject_possessive} date of birth is {object}.", "gpt_checks": []},
    "date of death": {"template": "{subject_possessive} date of death is {object}.", "gpt_checks": []},
    "director": {"template": "{subject_possessive} director is {object}.", "gpt_checks": ["possessive_naturalness"]},
    "doctoral advisor": {"template": "{subject_possessive} doctoral advisor is {object}.", "gpt_checks": []},
    "editor": {"template": "{subject_possessive} editor is {object}.", "gpt_checks": ["possessive_naturalness"]},
    "educated at": {"template": "{subject} was educated at {object}.", "gpt_checks": []},
    "employer": {"template": "{subject_possessive} employer is {object}.", "gpt_checks": []},
    "founded by": {"template": "{object} was a founder of {subject}.", "gpt_checks": ["article_naturalness"]},
    "has part": {"template": "{object} is a member of {subject}.", "gpt_checks": ["membership_wording"]},
    "inception": {"template": "{subject} was established in {object}.", "gpt_checks": ["entity_same_issue", "mismatch_check"]},
    "manufacturer": {"template": "{subject_possessive} manufacturer is {object}.", "gpt_checks": ["possessive_naturalness"]},
    "mother": {"template": "{subject_possessive} mother is {object}.", "gpt_checks": []},
    "occupation": {"template": "{subject} is {indefinite_article} {object}.", "gpt_checks": ["pseudo_vowel_article"]},
    "performer": {"template": "\"{subject}\" is performed by {object}.", "gpt_checks": ["verify_subject_is_song"]},
    "place of birth": {"template": "{subject_possessive} place of birth is {object}.", "gpt_checks": ["article_naturalness"]},
    "place of burial": {"template": "{subject_possessive} place of burial is {object}.", "gpt_checks": ["article_naturalness"]},
    "place of death": {"template": "{subject_possessive} place of death is {object}.", "gpt_checks": ["article_naturalness", "use_only_as_last_priority_relation"]},
    "place of detention": {"template": "{subject_possessive} place of detention was {object}.", "gpt_checks": ["direct_or_derived_support"]},
    "presenter": {"template": "{subject} is presented by {object}.", "gpt_checks": ["entity_same_issue"]},
    "producer": {"template": "{subject} is produced by {object}.", "gpt_checks": []},
    "publisher": {"template": "{subject} is published by {object}.", "gpt_checks": ["definite_article_restoration"]},
    "sibling": {"template": "{subject} is a sibling of {object}.", "gpt_checks": []},
    "spouse": {"template": "{subject} was married to {object}.", "gpt_checks": ["current_marriage_tense"]},
    "student of": {"template": "{subject} was a student of {object}.", "gpt_checks": []}
  }
}

